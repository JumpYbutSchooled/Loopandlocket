{
  "name": "loopandlocket",
  "private": true,
  "description": "Build tools only. The site itself has no build step; this just refreshes public/js/vendor/firebase.js.",
  "scripts": {
    "build:firebase": "node node_modules/esbuild/bin/esbuild tools/firebase-entry.js --bundle --format=esm --minify --target=safari15,chrome100,firefox100 --legal-comments=none --outfile=public/js/vendor/firebase.js"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "firebase": "12.19.0"
  }
}
